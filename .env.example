# Copy to .env and fill in whichever keys you have. Every key is optional;
# sections without a key show search links instead of data.

# Homes for sale (free tier: 50 requests/month) - https://www.rentcast.io/api
RENTCAST_API_KEY=

# Best-rated restaurants - https://www.yelp.com/developers
YELP_API_KEY=

# GreatSchools 1-10 ratings (paid) - https://www.greatschools.org/api/
# Without it, schools are rated from PA state test proficiency.
GREATSCHOOLS_API_KEY=

# FBI crime data (free, instant) - https://api.data.gov/signup/
# DEMO_KEY works but allows only ~30 requests/hour.
DATA_GOV_API_KEY=

# Optional, raises Census rate limits - https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=
